// #############################################
// Proxmox Clusters OpenTelemetry Configuration
// #############################################

// Setup OpenTelemetry reciever "collector"
otelcol.receiver.otlp "proxmox" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.exporter.prometheus.to_prom.input]
  }
}

// Any needed labeling or modification will be in this block
otelcol.exporter.prometheus "to_prom" {
  forward_to = [prometheus.remote_write.default.receiver]
}

// Send to Prometheus
prometheus.remote_write "default" {
  endpoint {
    url = "http://PROM_ENDPOINT:9090/api/v1/write"
  }
}
